# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geofence_attendance
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# Google Sign-In: comma-separated OAuth client IDs whose ID tokens are accepted.
# Must include the Web client ID the mobile app passes as webClientId.
GOOGLE_CLIENT_IDS=your_web_client_id.apps.googleusercontent.com

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Default Admin
DEFAULT_ADMIN_EMAIL=admin@institution.edu.gh
DEFAULT_ADMIN_PASSWORD=Admin@123
